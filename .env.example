# Supabase project settings (Project Settings > Data API / API Keys).
# Use the project address only, without /rest/v1/ at the end.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public address of the app, used in sign-up confirmation links and in the
# widget embed code. In production, for example https://usher.xonik.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase secret key. The chat engine uses it to read industry
# packs and save conversations; the scripts and tests use it too.
# Never expose it in the browser or commit it.
SUPABASE_SECRET_KEY=

# Claude API settings for the chat engine. Server-only, never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# How much reasoning the model does per reply: low, medium, high, xhigh or max.
ANTHROPIC_EFFORT=low

# Embeddings for document search. Server-only, never sent to the browser.
# The model must produce 1024-dimension vectors (see src/lib/embeddings.ts).
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-4

# Public chat API: messages per minute from one visitor IP (default 20).
PUBLIC_CHAT_IP_LIMIT_PER_MINUTE=20

# Lead alert emails, sent with Resend (resend.com > API Keys). Server-only.
# Without a verified domain, Resend only delivers to your own account's email
# address, from onboarding@resend.dev. After verifying your domain, set a
# sender on it, for example: Clinic Leads <leads@usher.xonik.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Time zone for lead dates, daily counts and alert emails (default Asia/Kolkata).
LEADS_TIMEZONE=Asia/Kolkata
